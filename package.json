{
  "name": "openrouter-chat-client",
  "version": "1.0.0",
  "displayName": "OpenRouter Chat",
  "description": "Mobile chat client for OpenRouter API with streaming support",
  "main": "index.html",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "serve": "npx serve .",
    "serve:www": "npx serve www",
    "cordova": "cordova",
    "cordova:prepare": "cordova prepare",
    "cordova:build": "cordova build",
    "cordova:build:ios": "cordova build ios",
    "cordova:build:android": "cordova build android",
    "cordova:run:ios": "cordova run ios",
    "cordova:run:android": "cordova run android",
    "cordova:emulate:ios": "cordova emulate ios",
    "cordova:emulate:android": "cordova emulate android",
    "android:debug": "cordova build android --debug",
    "android:release": "cordova build android --release",
    "ios:debug": "cordova build ios --debug",
    "ios:release": "cordova build ios --release"
  },
  "cordova": {
    "plugins": {
      "cordova-plugin-statusbar": {},
      "cordova-plugin-splashscreen": {},
      "cordova-plugin-whitelist": {}
    },
    "platforms": [
      "ios",
      "android"
    ]
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.6.0",
    "cordova": "^13.0.0",
    "cordova-android": "^13.0.0",
    "cordova-ios": "^7.1.0",
    "cordova-plugin-splashscreen": "^6.0.2",
    "cordova-plugin-statusbar": "^4.0.0",
    "cordova-plugin-whitelist": "^1.3.5",
    "jsdom": "^24.0.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "openrouter",
    "chat",
    "streaming",
    "ai",
    "cordova",
    "mobile",
    "ios",
    "android"
  ],
  "license": "MIT"
}
